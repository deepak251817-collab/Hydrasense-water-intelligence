[TEMPLATE]
APP_NAME=HydraSense API
APP_ENV=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hydrasense

# REQUIRED. Never commit a real value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start when this is missing; in APP_ENV=production it also
# refuses to start when it is shorter than 32 characters or is a known
# placeholder/insecure default. Rotating it invalidates all issued tokens.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: comma-separated explicit frontend origins. Empty = local dev/preview
# origins when APP_ENV != production, deny-all cross-origin when production
# (set this to your real frontend origin before shipping a browser client).
# "*" is rejected whenever CORS_ALLOW_CREDENTIALS=true and in production.
# e.g. CORS_ALLOW_ORIGINS=https://app.example.com
CORS_ALLOW_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,Accept,X-Requested-With,Origin

# Rate limiting (shared through the rate_limit_counters table in PostgreSQL,
# so limits hold across workers and restarts). Run alembic upgrade head to
# create the table.
RATE_LIMIT_ENABLED=true
# Set true ONLY behind a reverse proxy you control (uses X-Forwarded-For).
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_ACTIVATE_MAX=10
RATE_LIMIT_ACTIVATE_WINDOW_SECONDS=3600

# MQTT broker (subscriber for ESP32 telemetry).
# Credentials are REQUIRED in production; the API refuses to start without
# them unless MQTT_ALLOW_ANONYMOUS=true (local development only). Values never
# appear in logs. Configure broker ACLs so each device may only publish its own
# station topic, and the backend may only subscribe to telemetry.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=hydrasense/stations
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=hydrasense-backend
MQTT_ALLOW_ANONYMOUS=false
# TLS is mandatory as soon as the broker is not on this host.
MQTT_USE_TLS=false
# Optional private CA bundle path; empty uses the system trust store.
MQTT_CA_CERT_PATH=

# Public web origin used by printed QR deep links.
PUBLIC_BASE_URL=http://localhost:5173